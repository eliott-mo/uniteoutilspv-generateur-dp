# Fins de ligne LF, dans le dépôt comme à la sortie de checkout.
# packages.txt en CRLF est silencieusement ignoré par Streamlit Community Cloud.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
*.ttf binary
*.otf binary
*.xlsx binary
# Le DXF est un format texte, mais c'est une pièce d'entrée fournie par le
# bureau d'études : elle est conservée octet pour octet, comme elle a été
# reçue et mesurée.
*.dxf binary
