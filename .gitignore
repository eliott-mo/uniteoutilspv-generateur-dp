__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Sorties de génération et projets locaux : volumineux, régénérables.
sortie/
projets/

# Dossiers DP de référence déposés dans exemples/ : binaires volumineux,
# consultés en local, sans intérêt dans l'historique.
exemples/**/*.pdf
# Sauf les plans projet PDF du lot 2ter : ce sont des pièces d'entrée, lues
# par l'outil et mesurées par les tests, pas des dossiers de référence. Ils
# pèsent de 250 à 460 Ko.
!exemples/gannay-PDF/*.pdf
!exemples/bray-saint-aignan-PDF/Plan implantation_Bray-Saint-Aignan.pdf
!exemples/bray-saint-aignan-PDF/Plan implantation_Bray-Saint-Aignan_2026-09-24.pdf

# Sources AutoCAD des plans du BE : seul le DXF exporté est lu par l'outil.
# Le DWG pèse dix fois plus lourd, et les fichiers de verrou n'ont aucun sens
# hors de la session AutoCAD qui les a posés.
exemples/**/*.dwg
exemples/**/*.bak
exemples/**/*.dwl
exemples/**/*.dwl2
# DXF du BE trop lourds pour l'historique : ceux de Sarnois pèsent 47 et
# 50 Mo, essentiellement le maillage topographique (4 044 points cotés en
# blocs, 1 898 points de terrain, des 3DSOLID par module). Le jeu de
# référence versionné reste Saint-Cyr, à 1,4 Mo ; les mécanismes qu'ils ont
# révélés sont couverts par des DXF synthétiques dans les tests.
exemples/sarnois-*/*.dxf

# Classeur des dimensions standard UNITe : petit, lisible, et cest la
# reference des cotes des ouvrages. Il reste versionne.
!exemples/Standards UNITe*.xlsx

# Fichiers de verrou Excel, créés tant que le classeur est ouvert.
~$*
